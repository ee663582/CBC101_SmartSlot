# Optional local app configuration. Export values in your shell before launch.
NORWARE_HOST=127.0.0.1
NORWARE_PORT=8765
# NORWARE_DB_PATH=/path/to/private/norware.sqlite3
# These only seed an initial account on a new database. Existing staff can change passwords in the app.
# NORWARE_DEMO_USER=staff.demo
# NORWARE_DEMO_PASSWORD=choose-a-new-temporary-password
# Local-only fallback for a fresh database is "123"; override it before first launch outside a disposable demo.
# NORWARE_WASTE_CONFIG=/path/to/waste_config.json

# Optional AI explanations through OpenAI Responses API. Leave unset for deterministic local guidance.
# OPENAI_API_KEY=
# NORWARE_AI_MODEL=gpt-6-astra
